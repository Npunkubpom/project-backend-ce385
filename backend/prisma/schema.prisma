// โครงสร้างฐานข้อมูลของ August Spa
// ชื่อในโค้ดเป็น camelCase ส่วนชื่อจริงในฐานข้อมูลเป็น snake_case (@map / @@map)

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum RoomStatus {
  AVAILABLE
  UNAVAILABLE
}

enum AppointmentStatus {
  PENDING   // รอร้านยืนยัน
  CONFIRMED // ยืนยันแล้ว (มีพนักงาน + ห้อง)
  COMPLETED // ให้บริการเสร็จแล้ว
  CANCELLED // ยกเลิก
}

enum PaymentMethod {
  BANK_TRANSFER
  PAY_AT_SHOP
}

enum PaymentStatus {
  PENDING // ลูกค้าแจ้งชำระแล้ว รอแอดมินตรวจ
  PAID    // แอดมินยืนยันแล้ว → ออกเลขใบเสร็จ
  FAILED  // ไม่ผ่าน / คิวถูกยกเลิก
}

/// บัญชีสำหรับล็อกอิน — ลูกค้า (USER) ผูกกับ customer ส่วน ADMIN ไม่ผูก
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(20)
  passwordHash String   @map("password_hash") // เก็บค่าแฮชจาก bcrypt เท่านั้น ไม่เคยเก็บรหัสจริง
  role         Role     @default(USER)
  customerId   Int?     @unique @map("customer_id")
  createdAt    DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id])

  @@map("users")
}

model Customer {
  id        Int    @id @default(autoincrement())
  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)
  phone     String @db.VarChar(10)

  user         User?
  appointments Appointment[]

  @@map("customers")
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(150)
  price       Int     // บาท
  duration    Int     // นาที
  description String?

  appointments Appointment[]

  @@map("services")
}

model Employee {
  id        Int    @id @default(autoincrement())
  firstName String @map("first_name") @db.VarChar(100)
  lastName  String @map("last_name") @db.VarChar(100)
  phone     String @db.VarChar(10)

  appointments Appointment[]

  @@map("employees")
}

model Room {
  id     Int        @id @default(autoincrement())
  name   String     @db.VarChar(100)
  status RoomStatus @default(AVAILABLE)

  appointments Appointment[]

  @@map("rooms")
}

model Appointment {
  id         Int               @id @default(autoincrement())
  customerId Int               @map("customer_id")
  serviceId  Int               @map("service_id")
  employeeId Int?              @map("employee_id") // ว่างได้จนกว่าแอดมินจะจัดให้
  roomId     Int?              @map("room_id")
  startAt    DateTime          @map("start_at")
  endAt      DateTime          @map("end_at")
  price      Int               // ราคา ณ วันที่จอง (คัดลอกจาก service ไม่รับจาก client)
  status     AppointmentStatus @default(PENDING)
  note       String?           @db.VarChar(500)
  createdAt  DateTime          @default(now()) @map("created_at")

  customer Customer  @relation(fields: [customerId], references: [id])
  service  Service   @relation(fields: [serviceId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict) // ลบพนักงานที่มีคิวไม่ได้
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payment  Payment?

  @@map("appointments")
}

model Payment {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @unique @map("appointment_id") // 1 คิวชำระได้ครั้งเดียว
  amount        Int           // คัดลอกจากราคาของคิว
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  receiptNo     String?       @unique @map("receipt_no") @db.VarChar(30)
  createdAt     DateTime      @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}
