# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env ขึ้น GitHub

# ฐานข้อมูล: postgresql://ผู้ใช้:รหัสผ่าน@โฮสต์:พอร์ต/ชื่อฐานข้อมูล
DATABASE_URL="postgresql://postgres:myPassword@localhost:5432/spa_db?schema=public"
PORT=3000

# กุญแจลับสำหรับเซ็น JWT — ตั้งเป็นข้อความสุ่มยาว ๆ (อย่างน้อย 32 ตัวอักษร)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# หน้าเว็บ React ที่อนุญาตให้เรียก API (CORS)
FRONTEND_URL="http://localhost:5173"

# รหัสผ่านของบัญชี admin ที่ npm run seed จะสร้างให้
ADMIN_PASSWORD="Admin1234"
